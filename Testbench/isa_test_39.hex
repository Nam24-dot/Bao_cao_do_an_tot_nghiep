123450b7 // lui   x1, 0x12345       - Lệnh 1: Nạp 20-bit cao vào x1 (x1 = 0x12345000)
12345117 // auipc x2, 0x12345       - Lệnh 2: Cộng hằng số vào PC
67808193 // addi  x3, x1, 0x678     - Lệnh 3: Cộng hằng số (I-type)
0000a213 // slti  x4, x1, 0         - Lệnh 4: So sánh nhỏ hơn 0 (có dấu)
0000b293 // sltiu x5, x1, 0         - Lệnh 5: So sánh nhỏ hơn 0 (không dấu)
fff0c313 // xori  x6, x1, -1        - Lệnh 6: Đảo bit (XOR với 0xFFFFFFFF)
fff0e393 // ori   x7, x1, -1        - Lệnh 7: Phép OR với hằng số
fff0f413 // andi  x8, x1, -1        - Lệnh 8: Phép AND với hằng số
00409493 // slli  x9, x1, 4         - Lệnh 9: Dịch trái logic 4 bit
0040d513 // srli  x10, x1, 4        - Lệnh 10: Dịch phải logic 4 bit (Điền 0)
4040d593 // srai  x11, x1, 4        - Lệnh 11: Dịch phải số học 4 bit (Giữ dấu)
00208633 // add   x12, x1, x2       - Lệnh 12: Cộng 2 thanh ghi
402086b3 // sub   x13, x1, x2       - Lệnh 13: Trừ 2 thanh ghi
00209733 // sll   x14, x1, x2       - Lệnh 14: Dịch trái theo thanh ghi
0020a7b3 // slt   x15, x1, x2       - Lệnh 15: So sánh nhỏ hơn (có dấu)
0020b833 // sltu  x16, x1, x2       - Lệnh 16: So sánh nhỏ hơn (không dấu)
0020c8b3 // xor   x17, x1, x2       - Lệnh 17: Phép XOR 2 thanh ghi
0020d933 // srl   x18, x1, x2       - Lệnh 18: Dịch phải logic theo thanh ghi
4020d9b3 // sra   x19, x1, x2       - Lệnh 19: Dịch phải số học theo thanh ghi
0020ea33 // or    x20, x1, x2       - Lệnh 20: Phép OR 2 thanh ghi
0020fab3 // and   x21, x1, x2       - Lệnh 21: Phép AND 2 thanh ghi
