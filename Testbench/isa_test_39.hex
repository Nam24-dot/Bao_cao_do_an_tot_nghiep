200f0f13 // addi  x30, x30, 0x200   - x30 = 0x200 (Địa chỉ test RAM)
001f2023 // sw    x1, 0(x30)        - Lệnh 22: Ghi Word (32-bit) xuống RAM
001f1223 // sh    x1, 4(x30)        - Lệnh 23: Ghi Halfword (16-bit)
001f0423 // sb    x1, 8(x30)        - Lệnh 24: Ghi Byte (8-bit)
000f2b03 // lw    x22, 0(x30)       - Lệnh 25: Đọc Word (32-bit)
004f1b83 // lh    x23, 4(x30)       - Lệnh 26: Đọc Halfword (có mở rộng dấu)
004f5c03 // lhu   x24, 4(x30)       - Lệnh 27: Đọc Halfword (không mở rộng dấu)
008f0c83 // lb    x25, 8(x30)       - Lệnh 28: Đọc Byte (có mở rộng dấu)
008f4d03 // lbu   x26, 8(x30)       - Lệnh 29: Đọc Byte (không mở rộng dấu)
00108463 // beq   x1, x1, +8        - Lệnh 30: Rẽ nhánh nếu BẰNG (Nhảy qua bẫy)
00100073 // ebreak                  - BẪY LỖI! (Nếu beq sai, rơi vào đây dừng CPU)
00101463 // bne   x0, x1, +8        - Lệnh 31: Rẽ nhánh nếu KHÁC
